rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
        request.auth.token.email in get(/databases/$(database)/documents/huntConfig/global).data.adminEmails;
    }

    // Mystery Hunt
    match /levelCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow read, write: if isAdmin();
    }

    match /huntConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /huntPlayers/{playerId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == playerId;
    }
    
    match /config/secrets {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TECH-SHARAJ
    match /techSharaj/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /techSharajScores/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == docId;
    }

    // Prompt Wars
    match /promptWars/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /promptWarsSubmissions/{docId} {
      allow read: if isAdmin();
      allow create: if true;
    }

    // AI Eye
    match /aiEyeImages/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /aiEyeScores/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == docId;
    }

    // Tech Quiz
    match /techQuizQuestions/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /techQuizScores/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == docId;
    }

    match /gameRequests/{docId} {
      allow read: if true;
      allow write: if request.auth != null && (docId.matches(request.auth.uid + '.*') || isAdmin());
    }

    match /arcadeScores/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == docId;
    }
  }
}
